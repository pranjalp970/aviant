# Copy this file to .env.local and fill in ONE voice provider.
# .env.local is git-ignored — never commit real keys or paste them in chat.
# Restart `npm run dev` after editing.

# ── Natural voice for the CFI/DPE (pick one) ───────────────────────
# ElevenLabs — most human-sounding. Key: elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=
# Optional: voice IDs from your ElevenLabs Voice Library (defaults: George / Adam)
# ELEVENLABS_VOICE_CFI=
# ELEVENLABS_VOICE_DPE=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI — cheaper, follows tone instructions. Key: platform.openai.com → API keys
OPENAI_API_KEY=
# Optional voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
# OPENAI_VOICE_CFI=coral
# OPENAI_VOICE_DPE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── Supabase (database + auth) ─────────────────────────────────────
# Dashboard → Connect (or Project Settings → Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── AI examiner / tutor (Claude) ───────────────────────────────
# Key: platform.claude.com → API Keys. Without it, the sample engine is used.
ANTHROPIC_API_KEY=

# ── Daily per-student limits for paid services (optional) ──────────
# AI_DAILY_REPLY_LIMIT=60
# TTS_DAILY_CHAR_LIMIT=20000

# ── Site details (optional; defaults shown) ────────────────────────
# NEXT_PUBLIC_SITE_URL=https://aviantapp.com
# NEXT_PUBLIC_SUPPORT_EMAIL=aviantsupport@aviantapp.com
